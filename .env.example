# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# KONEKSI SUPABASE / DATABASE
# ========================================================

# METODE 1: API KEY & URL (PALING MUDAH - TANPA PASSWORD DATABASE)
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# METODE 2: Connection String URI (Opsional untuk PostgreSQL Direct)
# Dapatkan di Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# METODE 3: Parameter individual PostgreSQL
# SQL_HOST="db.[PROJECT-REF].supabase.co"
# SQL_PORT="5432"
# SQL_USER="postgres"
# SQL_PASSWORD="your-supabase-db-password"
# SQL_DB_NAME="postgres"
